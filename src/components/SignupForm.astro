---
import { SIGNUP_ENDPOINT } from '../config/signup';
import { WATCHLIST } from '../config/watchlist';

// social-watchlist is the only list the signup function accepts
// (supabase/functions/socialteardown-signup/rules.ts).
export type SignupList = 'newsletter' | 'social-watchlist';

interface Props {
  /** Hidden `list` value sent with the signup. */
  list?: SignupList;
  button?: string;
  id?: string;
}
const { list = 'newsletter', button = 'Sign up', id = `signup-${list}` } = Astro.props;
// Unset endpoint: JS shows "Signups open soon" inline; without JS the form
// lands on a static page that says the same thing.
const action = SIGNUP_ENDPOINT ?? '/signups-soon/';
const method = SIGNUP_ENDPOINT ? 'post' : 'get';
// Small print under the form: what each list sends and how often.
const NOTES: Record<SignupList, string> = {
  newsletter: 'One email when the daily board launches. Unsubscribe anytime.',
  'social-watchlist': 'One email when the Watchlist opens, and nothing before that. Unsubscribe anytime.',
};
const note = NOTES[list];
// The Watchlist form adds two optional fields (labels in src/config/watchlist.ts).
// The endpoint drops a value that does not fit instead of refusing the signup,
// so neither has a pattern that could block submit.
const watchlist = list === 'social-watchlist';
// The page this form is on, fixed at build time. The endpoint stores it and
// sends an invalid address back here (the Referer can't be relied on: the
// site's Referrer-Policy sends only the origin cross-site).
const source = Astro.url.pathname;
---
<form class="signup" action={action} method={method} data-signup data-live={SIGNUP_ENDPOINT ? 'true' : 'false'}>
  <input type="hidden" name="list" value={list} />
  <input type="hidden" name="source" value={source} />
  <!-- Honeypot: off-screen, out of the tab order and hidden from assistive tech. Bots fill it; the endpoint drops those. No real field may be named website. -->
  <div class="hp" aria-hidden="true">
    <label for={`${id}-website`}>Website</label>
    <input id={`${id}-website`} type="text" name="website" tabindex="-1" autocomplete="off" />
  </div>
  <div class="field">
    <label for={`${id}-email`}>{watchlist ? WATCHLIST.labels.email : 'Email address'}</label>
    <input id={`${id}-email`} type="email" name="email" autocomplete="email" required placeholder="you@company.com" />
    {!watchlist && <button class="btn btn--accent" type="submit">{button}</button>}
  </div>
  {watchlist && (
    <>
      <div class="field">
        <label for={`${id}-handle`}>{WATCHLIST.labels.handle}</label>
        <input id={`${id}-handle`} type="text" name="handle" maxlength="200" autocomplete="off" autocapitalize="none" spellcheck="false" placeholder={WATCHLIST.placeholders.handle} aria-describedby={`${id}-handle-hint`} />
        <p id={`${id}-handle-hint`} class="field-hint">{WATCHLIST.hints.handle}</p>
      </div>
      <div class="field">
        <label for={`${id}-brands`}>{WATCHLIST.labels.brands}</label>
        <input id={`${id}-brands`} type="text" name="brands" maxlength="300" autocomplete="off" aria-describedby={`${id}-brands-hint`} />
        <p id={`${id}-brands-hint`} class="field-hint">{WATCHLIST.hints.brands}</p>
      </div>
      <div class="field">
        <button class="btn btn--accent" type="submit">{button}</button>
      </div>
    </>
  )}
  <p class="form-status" role="status" aria-live="polite"></p>
  <p class="form-note">{note} <a href="/privacy/">Privacy</a>.</p>
</form>
<style>
  .form-note { margin-top: 10px; font-size: 0.8125rem; color: var(--muted); }
  :global(.dark) .form-note { color: var(--on-dark-muted); }
  .form-note a { color: inherit; }
  .field-hint { flex-basis: 100%; font-size: 0.8125rem; color: var(--muted); }
  :global(.dark) .field-hint { color: var(--on-dark-muted); }
  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
</style>
<script>
  // The endpoint redirects back with ?signup=invalid for a bad address; other failures go to /signed-up/?signup=error.
  const outcomes: Record<string, string> = {
    invalid: "That email address doesn't look right.",
  };
  const message = outcomes[new URLSearchParams(location.search).get('signup') ?? ''];
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-signup]')) {
    if (form.dataset.live === 'true') {
      const status = form.querySelector<HTMLElement>('.form-status');
      if (message && status) status.textContent = message;
      continue;
    }
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const status = form.querySelector<HTMLElement>('.form-status');
      if (status) status.textContent = 'Signups open soon. Nothing was sent.';
    });
  }
</script>
